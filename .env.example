# Local Vinext development only: copy this file to `.env.local`.
# The deployed Cloudflare Worker continues to use encrypted Worker secrets.
# A publishable key is safe to use with RLS; never put a secret/service-role key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Sanity Content Lake. Leave the token empty for a public dataset.
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_READ_TOKEN=

# Cloudflare Stream video UID. When empty, Vault uses the local MP4 fallback.
CLOUDFLARE_STREAM_EXIM_UID=
