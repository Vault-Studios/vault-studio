# Local Vinext development only: copy this file to `.env.local`.
# The deployed Cloudflare Worker continues to use encrypted Worker secrets.
# A publishable key is safe to expose only when its tables are protected by RLS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Replace this placeholder only in the ignored `.env.local` copy. The server-only
# key is consumed by lib/gallery-server.ts and must never use NEXT_PUBLIC_/VITE_
# or appear in browser code, responses, logs, or cookies.
SUPABASE_SERVER_KEY=sb_secret_YOUR_SERVER_KEY

# Sanity Content Lake. Leave the token empty for a public dataset.
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_READ_TOKEN=

# Cloudflare Stream video UID. When empty, Vault uses the local MP4 fallback.
CLOUDFLARE_STREAM_EXIM_UID=
